{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cli/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/cli",
        "format": ["cjs"],
        "bundle": true,
        "main": "apps/cli/src/main.ts",
        "tsConfig": "apps/cli/tsconfig.build.json",
        "assets": [
          "apps/cli/src/assets",
          {
            "input": "apps/cli/src/commands/install-skill-templates",
            "glob": "**/*",
            "output": "install-skill-templates"
          }
        ],
        "generatePackageJson": true,
        "skipTypeCheck": true,
        "esbuildConfig": "apps/cli/esbuild.config.js",
        "sourcemap": true
      },
      "configurations": {
        "development": {},
        "production": {
          "sourcemap": false
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/cli/package.json",
        "{workspaceRoot}/dist/apps/cli/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/cli/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/cli/patches",
        "{workspaceRoot}/dist/apps/cli/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ]
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/cli/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^typecheck", "typecheck-spec"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/types/**/*",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/apps/cli/**/*.d.ts",
        "{workspaceRoot}/dist/out-tsc/apps/cli/tsconfig.app.tsbuildinfo"
      ],
      "options": {
        "cwd": "apps/cli",
        "command": "tsc --build tsconfig.app.json --emitDeclarationOnly"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/types/**/*"],
      "options": {
        "cwd": "apps/cli",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/dist/test-results/{projectRoot}"],
      "options": {
        "cwd": "apps/cli",
        "command": "vitest"
      },
      "configurations": {
        "ci": {
          "command": "vitest --run --coverage"
        },
        "watch": {
          "command": "vitest --watch"
        }
      }
    }
  }
}
