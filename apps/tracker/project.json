{
  "name": "tracker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "",
  "sourceRoot": "apps/tracker/src",
  "tags": [],
  "targets": {
    "generate-tokens": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["cli:build"],
      "inputs": [
        "{workspaceRoot}/apps/tracker/src/i18n/**/*",
        "{workspaceRoot}/.lingo-tracker.json",
        "{workspaceRoot}/dist/apps/cli/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/apps/tracker/src/i18n-types/tracker-resources.ts",
        "{workspaceRoot}/apps/tracker/src/assets/i18n"
      ],
      "options": {
        "command": "node dist/apps/cli/main.cjs bundle --name tracker",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build", "generate-tokens"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/tracker",
        "browser": "apps/tracker/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/tracker/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/tracker/public"
          },
          {
            "glob": "**/*",
            "input": "apps/tracker/src/assets",
            "output": "/assets/"
          }
        ],
        "styles": [
          "node_modules/@fontsource/nunito/400.css",
          "node_modules/@fontsource/nunito/500.css",
          "node_modules/@fontsource/nunito/600.css",
          "node_modules/@fontsource/nunito/700.css",
          "node_modules/@fontsource/ibm-plex-mono/400.css",
          "node_modules/@fontsource/ibm-plex-mono/500.css",
          "node_modules/@fontsource/ibm-plex-mono/600.css",
          "node_modules/@fontsource/grechen-fuemen/latin-400.css",
          "node_modules/material-icons/iconfont/filled.css",
          "apps/tracker/src/styles.scss"
        ],
        "allowedCommonJsDependencies": ["@messageformat/core", "@messageformat/parser"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "25kb",
              "maximumError": "50kb"
            }
          ],
          "outputHashing": "all",
          "sourceMap": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": ["generate-tokens", "api:serve"],
      "readyWhen": {
        "signal": true
      },
      "configurations": {
        "production": {
          "buildTarget": "tracker:build:production"
        },
        "development": {
          "buildTarget": "tracker:build:development",
          "proxyConfig": "apps/tracker/proxy.conf.json"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "tracker:build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^typecheck", "typecheck-spec"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/types/**/*",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/*.ts",
          "transitive": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/apps/tracker/**/*.d.ts",
        "{workspaceRoot}/dist/out-tsc/apps/tracker/tsconfig.app.tsbuildinfo"
      ],
      "options": {
        "cwd": "apps/tracker",
        "command": "tsc --build tsconfig.app.json --emitDeclarationOnly"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate-tokens"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/*.ts"
        }
      ],
      "options": {
        "cwd": "apps/tracker",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "translationFixtures",
        {
          "dependentTasksOutputFiles": "**/*.ts"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/dist/test-results/{projectRoot}"],
      "dependsOn": ["generate-tokens"],
      "options": {
        "coverage.reportsDirectory": "../../coverage/apps/tracker"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "tracker:build",
        "staticFilePath": "dist/apps/tracker/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    }
  }
}
