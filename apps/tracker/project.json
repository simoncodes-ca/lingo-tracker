{
  "name": "tracker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "",
  "sourceRoot": "apps/tracker/src",
  "tags": [],
  "targets": {
    "generate-tokens": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["cli:build"],
      "inputs": [
        "{workspaceRoot}/apps/tracker/src/i18n/**/*",
        "{workspaceRoot}/.lingo-tracker.json",
        "{workspaceRoot}/dist/apps/cli/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/apps/tracker/src/i18n-types/tracker-resources.ts",
        "{workspaceRoot}/apps/tracker/src/assets/i18n"
      ],
      "options": {
        "command": "node dist/apps/cli/main.cjs bundle --name tracker",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build", "generate-tokens"],
      "options": {
        "outputPath": "dist/apps/tracker",
        "browser": "apps/tracker/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/tracker/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/tracker/public"
          },
          {
            "glob": "**/*",
            "input": "apps/tracker/src/assets",
            "output": "/assets/"
          }
        ],
        "styles": ["apps/tracker/src/styles.scss"],
        "allowedCommonJsDependencies": ["@messageformat/core"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "50kb",
              "maximumError": "20kb"
            }
          ],
          "outputHashing": "all",
          "sourceMap": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "tracker:build:production"
        },
        "development": {
          "buildTarget": "tracker:build:development",
          "proxyConfig": "apps/tracker/proxy.conf.json"
        }
      },
      "defaultConfiguration": "development",
      "dependsOn": ["generate-tokens", "api:serve"]
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "tracker:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "dependsOn": ["generate-tokens"],
      "options": {
        "reportsDirectory": "../../coverage/apps/tracker"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "tracker:build",
        "staticFilePath": "dist/apps/tracker/browser",
        "spa": true
      }
    }
  }
}
