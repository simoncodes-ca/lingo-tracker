{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/libs/core/spec",
    "moduleResolution": "bundler",
    "typeRoots": ["../../node_modules/@types", "../../node_modules", "../../types"],
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "../../types/**/*.d.ts"
  ]
}
