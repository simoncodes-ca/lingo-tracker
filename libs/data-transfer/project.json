{
  "name": "data-transfer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/data-transfer/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^typecheck", "typecheck-spec"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/types/**/*",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/libs/data-transfer/**/*.d.ts",
        "{workspaceRoot}/dist/out-tsc/libs/data-transfer/tsconfig.lib.tsbuildinfo"
      ],
      "options": {
        "cwd": "libs/data-transfer",
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/types/**/*"],
      "options": {
        "cwd": "libs/data-transfer",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/dist/test-results/{projectRoot}"],
      "options": {
        "coverage.reportsDirectory": "../../coverage/libs/data-transfer"
      }
    }
  }
}
